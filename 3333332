local function IdentifyGameState()
    local function check()
        if PlayerGui:FindFirstChild("ReactLobbyHud") then
            return "LOBBY"
        elseif PlayerGui:FindFirstChild("ReactUniversalHotbar") then
            return "GAME"
        end
        return nil
    end
    while true do
        local state = check()
        if state then
            GameState = state
            return state
        end
        task.wait(0.5)
    end
end

