local function CheckResOk(data)
    if data == true then return true end
    if type(data) == "table" and data.Success == true then return true end
    local success, IsModel = pcall(function()
        return data and data:IsA("Model")
    end)
    if success and IsModel then return true end
    if type(data) == "userdata" then return true end
    return false
end

local function GetCurrentWave()
    local label = PlayerGui:FindFirstChild("ReactGameTopGameDisplay", true)
    if label then
        local ok, val = pcall(function()
            return label.Frame.wave.container:FindFirstChild("value")
        end)
        if ok and val then
            local WaveNum = val.Text:match("(%d+)")
            return tonumber(WaveNum) or 0
        end
    end
    return 0
end

local OldInvoke = RemoteFunc.InvokeServer

RemoteFunc.InvokeServer = function(self, ...)
    local args = {...}
    local result = OldInvoke(self, ...)

    if RecordingMode then
        if args[1] == "Troops" and args[2] == "Place" then
            local data = args[3]
            local towerName = args[4]
            if data and towerName and CheckResOk(result) then
                local pos = data.Position
                task.defer(function()
                    local NewT = nil
                    local startTime = tick()
                    local existing = {}
                    for _, child in ipairs(workspace.Towers:GetChildren()) do
                        existing[child] = true
                    end
                    while not NewT and (tick() - startTime) < 5 do
                        for _, child in ipairs(workspace.Towers:GetChildren()) do
                            if not existing[child] then
                                for _, SubChild in ipairs(child:GetChildren()) do
                                    if SubChild.Name == "Owner" and SubChild.Value == LocalPlayer.UserId then
                                        NewT = child
                                        break
                                    end
                                end
                            end
                            if NewT then break end
                        end
                        if not NewT then task.wait(0.05) end
                    end
                    if NewT then
                        table.insert(PlacedTowers, NewT)
                        local idx = #PlacedTowers
                        table.insert(RecordedActions, {
                            type = "place",
                            index = idx,
                            name = towerName,
                            x = pos.X,
                            y = pos.Y,
                            z = pos.Z
                        })
                        AddLog("[Rec] Place: " .. towerName .. " #" .. idx)
                    end
                end)
            end
        elseif args[1] == "Troops" and args[2] == "Upgrade" then
            local data = args[4]
            if data and data.Troop then
                for i, t in ipairs(PlacedTowers) do
                    if t == data.Troop then
                        table.insert(RecordedActions, {
                            type = "upgrade",
                            index = i,
                            path = data.Path or 1
                        })
                        AddLog("[Rec] Upgrade tower #" .. i)
                        break
                    end
                end
            end
        elseif args[1] == "Troops" and args[2] == "Sell" then
            local data = args[3]
            if data and data.Troop then
                for i, t in ipairs(PlacedTowers) do
                    if t == data.Troop then
                        table.insert(RecordedActions, {
                            type = "sell",
                            index = i
                        })
                        AddLog("[Rec] Sell tower #" .. i)
                        table.remove(PlacedTowers, i)
                        break
                    end
                end
            end
        elseif args[1] == "Troops" and args[2] == "Target" then
            local data = args[4]
            if data and data.Troop then
                for i, t in ipairs(PlacedTowers) do
                    if t == data.Troop then
                        table.insert(RecordedActions, {
                            type = "target",
                            index = i,
                            target = data.Target
                        })
                        AddLog("[Rec] Target tower #" .. i .. " -> " .. tostring(data.Target))
                        break
                    end
                end
            end
        elseif args[1] == "Troops" and args[2] == "Abilities" then
            local data = args[4]
            if data and data.Troop then
                for i, t in ipairs(PlacedTowers) do
                    if t == data.Troop then
                        table.insert(RecordedActions, {
                            type = "ability",
                            index = i,
                            name = data.Name
                        })
                        AddLog("[Rec] Ability on tower #" .. i .. " -> " .. tostring(data.Name))
                        break
                    end
                end
            end
        end
    end

    return result
end

local function PlaceTower(TName, px, py, pz)
    if GameState ~= "GAME" then return false end

    AddLog("[Place] Placing: " .. TName)

    local existing = {}
    for _, child in ipairs(workspace.Towers:GetChildren()) do
        existing[child] = true
    end

    local success = false
    local attempts = 0
    while not success and attempts < 20 do
        local ok, res = pcall(function()
            return OldInvoke(RemoteFunc, "Troops", "Place", {
                Rotation = CFrame.new(),
                Position = Vector3.new(px, py, pz)
            }, TName)
        end)

        if ok and CheckResOk(res) then
            success = true
            break
        end
        attempts = attempts + 1
        task.wait(0.15)
    end

    if success then
        local NewT = nil
        local startTime = tick()
        while not NewT and (tick() - startTime) < 5 do
            for _, child in ipairs(workspace.Towers:GetChildren()) do
                if not existing[child] then
                    for _, SubChild in ipairs(child:GetChildren()) do
                        if SubChild.Name == "Owner" and SubChild.Value == LocalPlayer.UserId then
                            NewT = child
                            break
                        end
                    end
                end
                if NewT then break end
            end
            if not NewT then task.wait(0.05) end
        end

        if NewT then
            table.insert(PlacedTowers, NewT)
            AddLog("[OK] Tower placed at index " .. #PlacedTowers)
            return #PlacedTowers
        end
    end

    AddLog("[X] Failed to place tower")
    return false
end

local function UpgradeTower(idx, PathId)
    if GameState ~= "GAME" then return false end
    if not PlacedTowers[idx] then
        AddLog("[X] Tower index " .. idx .. " not found")
        return false
    end

    local t = PlacedTowers[idx]
    AddLog("[Upgrade] Tower " .. idx)

    local success = false
    local attempts = 0
    while not success and attempts < 20 do
        local ok, res = pcall(function()
            return OldInvoke(RemoteFunc, "Troops", "Upgrade", "Set", {
                Troop = t,
                Path = PathId or 1
            })
        end)
        if ok and CheckResOk(res) then
            success = true
            break
        end
        attempts = attempts + 1
        task.wait(0.15)
    end

    if success then
        AddLog("[OK] Tower " .. idx .. " upgraded")
    else
        AddLog("[X] Failed to upgrade")
    end

    return success
end

local function SellTower(idx)
    if GameState ~= "GAME" then return false end
    if not PlacedTowers[idx] then
        AddLog("[X] Tower index " .. idx .. " not found")
        return false
    end

    local t = PlacedTowers[idx]
    AddLog("[Sell] Tower " .. idx)

    local success = false
    local attempts = 0
    while not success and attempts < 20 do
        local ok, res = pcall(function()
            return OldInvoke(RemoteFunc, "Troops", "Sell", { Troop = t })
        end)
        if ok and CheckResOk(res) then
            success = true
            break
        end
        attempts = attempts + 1
        task.wait(0.15)
    end

    if success then
        table.remove(PlacedTowers, idx)
        AddLog("[OK] Tower " .. idx .. " sold")
    else
        AddLog("[X] Failed to sell")
    end

    return success
end

local function SetTarget(idx, TargetType)
    if GameState ~= "GAME" then return false end
    if not PlacedTowers[idx] then return false end

    local t = PlacedTowers[idx]
    pcall(function()
        OldInvoke(RemoteFunc, "Troops", "Target", "Set", {
            Troop = t,
            Target = TargetType
        })
        AddLog("[Target] Tower " .. idx .. " -> " .. TargetType)
    end)

    return true
end

local function ActivateAbility(idx, abilityName)
    if GameState ~= "GAME" then return false end
    if not PlacedTowers[idx] then return false end

    local t = PlacedTowers[idx]
    pcall(function()
        OldInvoke(RemoteFunc, "Troops", "Abilities", "Activate", {
            Troop = t,
            Name = abilityName,
            Data = {}
        })
        AddLog("[Ability] " .. abilityName .. " on tower " .. idx)
    end)

    return true
end

local function RunVoteSkip()
    local success = false
    local attempts = 0
    while not success and attempts < 10 do
        local ok = pcall(function()
            OldInvoke(RemoteFunc, "Voting", "Skip")
        end)
        if ok then
            success = true
            break
        end
        attempts = attempts + 1
        task.wait(0.2)
    end
    return success
end

local function WaitForMatchEnd()
    local lastWave = GetCurrentWave()
    task.wait(2)

    while true do
        local currentWave = GetCurrentWave()
        if currentWave ~= lastWave then
            lastWave = currentWave
            task.wait(2)
        end

        local rewardsGui = PlayerGui:FindFirstChild("ReactGameNewRewards")
        if rewardsGui then
            local ok, found = pcall(function()
                return rewardsGui.Frame.gameOver.RewardsScreen
            end)
            if ok and found then
                AddLog("[Match] Match ended!")
                task.wait(Globals.retryDelay or 2)
                RunVoteSkip()
                return true
            end
        end

        task.wait(0.5)
    end
end

