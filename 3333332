        AddLog("[Copy] No actions recorded!")
        return
    end

    local indexMap = {}
    local code = "local TDS = loadstring(game:HttpGet('https://raw.githubusercontent.com/Vodi4kasy1/scripts/refs/heads/main/3333332'))()\n\n"
    code = code .. "task.wait(2)\n\n"

    local placeCounter = 0

    for _, action in ipairs(RecordedActions) do
        if action.type == "place" then
            placeCounter = placeCounter + 1
            indexMap[action.index] = placeCounter
            code = code .. string.format("local idx%d = TDS:Place('%s', %.4f, %.4f, %.4f)\n", placeCounter, action.name, action.x, action.y, action.z)
        elseif action.type == "upgrade" then
            local mapped = indexMap[action.index]
            if mapped then
                code = code .. string.format("TDS:Upgrade(idx%d, %d)\n", mapped, action.path or 1)
            end
        elseif action.type == "sell" then
            local mapped = indexMap[action.index]
            if mapped then
                code = code .. string.format("TDS:Sell(idx%d)\n", mapped)
            end
        elseif action.type == "target" then
            local mapped = indexMap[action.index]
            if mapped then
                code = code .. string.format("TDS:SetTarget(idx%d, '%s')\n", mapped, tostring(action.target))
            end
        elseif action.type == "ability" then
            local mapped = indexMap[action.index]
            if mapped then
                code = code .. string.format("TDS:Ability(idx%d, '%s')\n", mapped, tostring(action.name))
            end
        end
    end

    code = code .. "\nTDS:WaitForMatchEnd()\n"

    setclipboard(code)
    AddLog("[OK] Code copied! " .. #RecordedActions .. " actions")

    local origColor = CopyButton.BackgroundColor3
    TweenService:Create(CopyButton, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 160, 80)}):Play()
    task.delay(0.6, function()
        TweenService:Create(CopyButton, TweenInfo.new(0.15), {BackgroundColor3 = origColor}):Play()
    end)
end)

local function MakeDraggable(frame, dragArea)
    local dragging = false
    local dragStartPos = nil
    local frameStartPos = nil

    dragArea.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStartPos = input.Position
            frameStartPos = frame.Position
        end
    end)

    dragArea.InputChanged:Connect(function(input)
        if dragging then
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local delta = input.Position - dragStartPos
                frame.Position = UDim2.new(
                    frameStartPos.X.Scale,
                    frameStartPos.X.Offset + delta.X,
                    frameStartPos.Y.Scale,
                    frameStartPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    dragArea.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

