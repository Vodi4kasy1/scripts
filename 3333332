            tbDragging = true
            tbMoved = false
            tbDragStart = input.Position
            tbFrameStart = ToggleBtn.Position
        end
    end)

    ToggleBtn.InputChanged:Connect(function(input)
        if tbDragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - tbDragStart
            if delta.Magnitude > 6 then
                tbMoved = true
            end
            ToggleBtn.Position = UDim2.new(
                tbFrameStart.X.Scale,
                tbFrameStart.X.Offset + delta.X,
                tbFrameStart.Y.Scale,
                tbFrameStart.Y.Offset + delta.Y
            )
        end
    end)

    ToggleBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            tbDragging = false
            if not tbMoved then
                MainFrame.Visible = not MainFrame.Visible
            end
        end
    end)
